{
    "name": "budai",
    "version": "1.0.0",
    "description": "BudAi - Emotionally Intelligent AI Companion",
    "scripts": {
        "start": "node backend/server.js",
        "dev": "concurrently \"npm run start-backend\" \"npm run start-frontend\"",
        "start-backend": "cd backend && npm start",
        "start-frontend": "cd budai-frontend && npm start",
        "heroku-postbuild": "echo 'Skipping build for Heroku'",
        "install-all": "npm install && cd backend && npm install && cd ../budai-frontend && npm install"
    },
    "engines": {
        "node": "22.x"
    },
    "keywords": [],
    "author": "Your Name",
    "license": "MIT",
    "dependencies": {
        "@google/generative-ai": "^0.21.0",
        "concurrently": "^8.2.1",
        "debug": "^4.4.0",
        "express-rate-limit": "^7.5.0",
        "firebase": "^11.2.0",
        "firebase-admin": "^13.1.0",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "helmet": "^7.1.0",
        "morgan": "^1.10.0",
        "node-cache": "^5.1.2"
    }
}